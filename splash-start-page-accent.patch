+
+/**
+ * Primary (accent) color of the work context the app opens on, for the launch
+ * screen. Mirrors `getStartPageUrlPath`: a missing, archived or hidden project
+ * falls back to Today. Planner, Schedule and Boards have no context color of
+ * their own, so they use Today's too.
+ */
+export const getStartPagePrimaryColor = (
+  defaultStartPage: number | string | undefined,
+  projects: readonly Pick<Project, 'id' | 'isArchived' | 'isHiddenFromMenu' | 'theme'>[],
+  tags: readonly Pick<Tag, 'id' | 'theme'>[],
+): string | null => {
+  const todayColor =
+    tags.find((t) => t.id === TODAY_TAG.id)?.theme?.primary ??
+    TODAY_TAG.theme.primary ??
+    null;
+
+  const projectId =
+    typeof defaultStartPage === 'string' && defaultStartPage.length > 0
+      ? defaultStartPage
+      : defaultStartPage === DefaultStartPage.Inbox
+        ? INBOX_PROJECT.id
+        : null;
+  if (projectId) {
+    const project = projects.find((p) => p.id === projectId);
+    return project && !project.isArchived && !project.isHiddenFromMenu
+      ? (project.theme?.primary ?? todayColor)
+      : todayColor;
+  }
+  return todayColor;
+};
