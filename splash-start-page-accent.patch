+/** Parses #rgb, #rrggbb(aa) and rgb()/rgba() into [r, g, b] (0–255). */
+const parseRgb = (color: string): [number, number, number] | null => {
+  const c = color.trim();
+  const hex = /^#([0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$/i.exec(c);
+  if (hex) {
+    let h = hex[1];
+    if (h.length === 3) {
+      h = h
+        .split('')
+        .map((ch) => ch + ch)
+        .join('');
+    }
+    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as [
+      number,
+      number,
+      number,
+    ];
+  }
+  const rgb = /^rgba?\(\s*([\d.]+)[\s,]+([\d.]+)[\s,]+([\d.]+)/i.exec(c);
+  return rgb ? [+rgb[1], +rgb[2], +rgb[3]] : null;
+};
+
+/**
+ * A color is only safe to hand to the inline script if it is a plain color:
+ * it ends up in a CSS custom property without further checks.
+ */
+export const isPlainColor = (color: unknown): color is string =>
+  typeof color === 'string' && parseRgb(color) !== null;
+
+/** Dark or light text, whichever reads better on `color` (WCAG luminance). */
+export const readableOn = (color: string): string => {
+  const rgb = parseRgb(color);
+  if (!rgb) {
+    return '#ffffff';
+  }
+  const [r, g, b] = rgb.map((v) => {
+    const s = v / 255;
+    return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+  });
+  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+  // Contrast vs white is (1.05)/(L+0.05), vs near-black (#131314) ~ (L+0.05)/0.057.
+  return luminance > 0.18 ? '#131314' : '#ffffff';
+};
